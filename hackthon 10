#include <stdio.h>
int main() {
    int num, firstDigit, secondLastDigit;
    printf("Enter a number: ");
    scanf("%d", &num);
    int temp = num;
    secondLastDigit = (temp / 10) % 10;
    while (temp >= 10) {
        temp = temp / 10;
    }
    firstDigit = temp;
    printf("Sum = %d\n", firstDigit + secondLastDigit);
    return 0;
}
