#include <stdio.h>
int main() {
    int num, d1, d2, d3, d4;
    printf("Enter a 4-digit number: ");
    scanf("%d", &num);
    d1 = num / 1000;
    d2 = (num / 100) % 10;
    d3 = (num / 10) % 10;
    d4 = num % 10;
    d1 = (d1 + 2) % 10;
    d2 = (d2 + 2) % 10;
    d3 = (d3 + 2) % 10;
    d4 = (d4 + 2) % 10;
    int result = d1 * 1000 + d2 * 100 + d3 * 10 + d4;
    printf("Result: %d", result);
    return 0;
}
